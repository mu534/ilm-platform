  "whyIlm": {
    "eyebrow": "Maaliif Ilm Platform?",
    "title": "Barachuun sirna qabeessa, amanamaa fi kaayyoo qabeessa ta'uu qaba.",
    "description": "Ilm Platform hayyoota gahumsa qaban, qabiyyee koorsii sirnaan qindaa'e fi hordoffii guddinaa walitti fida — kanaaf daqiiqaan ati barnoota irratti oolchitu hundi gatii qaba.",
    "features": {
      "structured": { "title": "Barnoota Sirna Qabeessa", "description": "Koorsiin tokkoon tokkoon isaanii moojuloota ifa ta'aniin, barnoota wal irraa fufaa, qormaataa fi hordoffii guddinaan qindaa'eera — yeroo hunda eessa akka jirtu akka beektuuf." },
      "scholars": { "title": "Hayyoota Gahumsa Qaban", "description": "Hayyoota mirkanaa'an fi barsiisota muuxannoo qaban irraa, kanneen saayinsii Islaamaa keessatti ogummaa gadi fagoo qaban irraa baradhu." },
      "progress": { "title": "Guddina Kee Hordofi", "description": "Galmeen kee, xumura barnootaa fi guddinni koorsii ofumaan ni hordofamu — imalli barnoota kee yeroo hunda akka mul'atuuf." },
      "pace": { "title": "Saffisa Kee irratti Baradhu", "description": "Qabiyyee koorsii hunda yeroo kamiyyuu, meeshaa kamirraayyuu argadhu; yeroo barbaadde hunda barnoota deebitee ilaali." }
    }
  },
