# ─────────────────────────────────────────────────────────────────────────────
# ILM PLATFORM — Environment Variables
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:password@localhost:5432/ilm_platform"

# ── NextAuth ──────────────────────────────────────────────────────────────────
# Generate a secure secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here"
# Your app URL (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
# Add authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ── Cloudinary (Media Uploads) ────────────────────────────────────────────────
# Get from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ── Resend (Email) ────────────────────────────────────────────────────────────
# Get from: https://resend.com — free 3,000 emails/month
# Leave empty to log emails to terminal in development
RESEND_API_KEY=""
EMAIL_FROM="noreply@yourdomain.com"

# ── Email Verification Enforcement ───────────────────────────────────────────
# Set to "true" to require email verification before login (RECOMMENDED for production)
# Leave "false" during development/testing
REQUIRE_EMAIL_VERIFICATION=false

# ── Admin Contact ─────────────────────────────────────────────────────────────
# Where contact form submissions are sent. Defaults to EMAIL_FROM if not set.
ADMIN_EMAIL="admin@yourdomain.com"

# ── Rate Limiting (Upstash Redis) ─────────────────────────────────────────────
# Recommended for production — without these, rate limiting falls back to an
# in-memory store that does NOT work correctly across multiple server
# instances or serverless deployments (each instance has its own counters).
# Free tier available at: https://upstash.com
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Paid Courses (Stripe) ──────────────────────────────────────────────────────
# Only required if any course has enrollmentType=PAID. Free-only platforms
# can leave these blank — nothing else depends on Stripe.
# Get keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=""
# Register a webhook endpoint at https://dashboard.stripe.com/webhooks pointing
# to {your-domain}/api/webhooks/stripe, subscribed to at least
# checkout.session.completed and checkout.session.expired. For local testing,
# use the Stripe CLI: `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# (it will print the webhook secret to use here).
STRIPE_WEBHOOK_SECRET=""
