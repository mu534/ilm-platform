generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  INSTRUCTOR
  USER
}

enum LectureType {
  TEXT
  VIDEO
  AUDIO
  PDF
}

enum DifficultyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CourseStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
}

enum NotificationType {
  NEW_LECTURE
  NEW_COURSE
  COMMENT_REPLY
  ANNOUNCEMENT
  COURSE_APPROVED
  COURSE_REJECTED
  NEW_FOLLOWER
  QUIZ_RESULT
  CERTIFICATE_ISSUED
  COURSE_ANNOUNCEMENT
}

enum MediaType {
  VIDEO
  AUDIO
  PDF
  IMAGE
  DOCUMENT
  LINK
}

enum MediaCategory {
  RESOURCE   // Lesson notes, workbooks, slides — supplementary lesson materials
  REFERENCE  // Qur'an verses, hadith, books, articles, external links
}

enum ReportReason {
  SPAM
  INAPPROPRIATE
  INCORRECT_CONTENT
  ABUSE
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

enum ContentApprovalStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

// ─── Auth Tokens ─────────────────────────────────────────────────────────────

model VerificationToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@map("password_reset_tokens")
}

// ─── Core User Models ─────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String?
  image         String?
  role          Role      @default(USER)
  bio           String?
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Existing relations
  lectures Lecture[]
  comments Comment[]
  scholar  Scholar?

  // New relations
  enrollments       Enrollment[]
  lectureProgress   LectureProgress[]
  quizAttempts      QuizAttempt[]
  certificates      Certificate[]
  bookmarks         Bookmark[]
  likes             Like[]
  courseRatings     CourseRating[]
  notifications     Notification[]
  following         ScholarFollow[]   @relation("UserFollowing")
  sentReports       Report[]          @relation("ReportedBy")
  resolvedReports   Report[]          @relation("ResolvedReports")
  auditLogs         AuditLog[]
  forumQuestions    ForumQuestion[]
  forumReplies      ForumReply[]
  forumVotes        ForumVote[]
  courses           Course[]
  announcements     CourseAnnouncement[] @relation("AnnouncementAuthor")
  preferredLanguage String            @default("en")
  stripeCustomerId  String?
  payments          Payment[]
  // Notification preferences — gate which in-app notifications get created.
  // Transactional ones (course approval, quiz results, certificates) are
  // always sent regardless, same as you can't turn off "your order shipped".
  notifyNewContent  Boolean           @default(true) // new lectures/courses from scholars you follow or courses you're enrolled in
  notifyComments    Boolean           @default(true) // replies to your comments

  @@map("users")
}

model Scholar {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio            String
  photo          String?
  professionalDesignation String?
  topics         String[]
  qualifications String[]
  featured       Boolean  @default(false)
  verified       Boolean  @default(false)
  verifiedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Existing relations
  lectures Lecture[]

  // New relations
  courses  Course[]
  followers ScholarFollow[]

  @@map("scholars")
}

// ─── Category ────────────────────────────────────────────────────────────────

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  color       String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  courses  Course[]
  lectures Lecture[]

  @@map("categories")
}

// ─── Course / Module / Lecture Hierarchy ─────────────────────────────────────

model Course {
  id                String       @id @default(cuid())
  title             String
  subtitle          String?      // short tagline shown below the title
  slug              String       @unique
  description       String
  shortDescription  String?      // brief summary shown on course cards (fallback: excerpt from description)
  thumbnailUrl      String?
  bannerUrl         String?
  objectives        String[]
  prerequisites     String[]
  difficulty        DifficultyLevel @default(BEGINNER)
  language          String       @default("en")
  estimatedDuration Int          @default(0) // in minutes
  tags              String[]
  // SEO
  seoTitle          String?
  seoDescription    String?
  // Enrollment (extensible — free for now, paid can be added later)
  enrollmentType    String       @default("FREE") // FREE | PAID
  // Price in the smallest currency unit (e.g. cents for USD). 0 = free.
  price             Int          @default(0)
  currency          String       @default("usd")
  // Cached Stripe IDs so we don't recreate the Product/Price on every checkout
  stripeProductId   String?
  stripePriceId     String?
  payments          Payment[]
  // When true, students must complete lectures in order — later lessons
  // stay locked until every lesson before them (in module/lecture order)
  // is marked complete.
  sequentialLearning Boolean     @default(false)
  status            CourseStatus @default(DRAFT)
  featured          Boolean      @default(false)
  published         Boolean      @default(false)
  categoryId        String?
  category          Category?    @relation(fields: [categoryId], references: [id])
  scholarId         String?
  scholar           Scholar?     @relation(fields: [scholarId], references: [id])
  authorId          String
  author            User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  approvalStatus    ContentApprovalStatus @default(DRAFT)
  approvalNote      String?
  reviewedAt        DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  modules     Module[]
  enrollments Enrollment[]
  ratings     CourseRating[]
  bookmarks   Bookmark[]
  certificates Certificate[]
  media       Media[]
  announcements CourseAnnouncement[]
  prerequisiteFor CoursePrerequisite[] @relation("PrerequisiteCourse")
  prerequisiteCourses CoursePrerequisite[] @relation("DependentCourse")
  reports         Report[]             @relation("CourseReports")

  @@index([status, published])
  @@index([categoryId])
  @@index([scholarId])
  @@map("courses")
}

model Module {
  id          String   @id @default(cuid())
  title       String
  description String?
  order       Int      @default(0)
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lectures Lecture[]
  quizzes  Quiz[]

  @@index([courseId])
  @@map("modules")
}

// ─── Lecture (extended from existing) ────────────────────────────────────────

model Lecture {
  id           String      @id @default(cuid())
  title        String
  slug         String      @unique
  description  String
  content      String?
  type         LectureType @default(TEXT)
  mediaUrl     String?
  thumbnailUrl String?
  tags         String[]
  published    Boolean     @default(false)
  featured     Boolean     @default(false)
  views        Int         @default(0)
  order        Int         @default(0)
  duration     Int?        // in seconds
  authorId     String
  author       User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  scholarId    String?
  scholar      Scholar?    @relation(fields: [scholarId], references: [id])
  moduleId     String?
  module       Module?     @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  categoryId   String?
  category     Category?   @relation(fields: [categoryId], references: [id])
  // Content approval
  approvalStatus ContentApprovalStatus @default(DRAFT)
  approvalNote   String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  comments  Comment[]
  progress  LectureProgress[]
  bookmarks Bookmark[]
  likes     Like[]
  media     Media[]

  @@index([moduleId])
  @@index([categoryId])
  @@index([authorId])
  @@map("lectures")
}

// ─── Comment (existing, unchanged structure) ─────────────────────────────────

model Comment {
  id        String   @id @default(cuid())
  body      String
  lectureId String
  lecture   Lecture  @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  approved  Boolean  @default(true)
  parentId  String?
  parent    Comment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reports Report[]

  @@index([lectureId])
  @@map("comments")
}

// ─── Enrollment & Progress ────────────────────────────────────────────────────

model Enrollment {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status      EnrollmentStatus @default(ACTIVE)
  progress    Float            @default(0) // percentage 0-100
  completedAt DateTime?
  enrolledAt  DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@map("enrollments")
}

enum PaymentStatus {
  PENDING    // Checkout session created, not yet paid
  COMPLETED  // Payment confirmed via webhook, enrollment granted
  FAILED     // Checkout expired or payment failed
  REFUNDED
}

model Payment {
  id                      String        @id @default(cuid())
  userId                  String
  user                    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId                String
  course                  Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  amount                  Int           // in smallest currency unit (cents)
  currency                String
  status                  PaymentStatus @default(PENDING)
  stripeCheckoutSessionId String        @unique
  stripePaymentIntentId   String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  @@index([userId])
  @@index([courseId])
  @@map("payments")
}

model LectureProgress {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lectureId     String
  lecture       Lecture  @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  completed     Boolean  @default(false)
  watchedSeconds Int     @default(0) // time spent in seconds
  completedAt   DateTime?
  lastViewedAt  DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, lectureId])
  @@index([userId])
  @@index([lectureId])
  @@map("lecture_progress")
}

// ─── Quiz System ──────────────────────────────────────────────────────────────

model Quiz {
  id           String   @id @default(cuid())
  title        String
  description  String?
  moduleId     String
  module       Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  passingScore Int      @default(70) // percentage
  timeLimit    Int?     // in minutes, null = no limit
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@index([moduleId])
  @@map("quizzes")
}

model QuizQuestion {
  id            String       @id @default(cuid())
  quizId        String
  quiz          Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question      String
  type          QuestionType @default(MULTIPLE_CHOICE)
  options       String[]     // JSON stringified options for MC
  correctAnswer String       // index for MC, "true"/"false" for TF
  explanation   String?
  order         Int          @default(0)
  points        Int          @default(1)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  answers QuizAnswer[]

  @@index([quizId])
  @@map("quiz_questions")
}

model QuizAttempt {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId      String
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  score       Float    @default(0) // percentage
  passed      Boolean  @default(false)
  timeTaken   Int?     // in seconds
  completedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  answers QuizAnswer[]

  @@index([userId])
  @@index([quizId])
  @@map("quiz_attempts")
}

model QuizAnswer {
  id         String       @id @default(cuid())
  attemptId  String
  attempt    QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer     String
  isCorrect  Boolean      @default(false)
  createdAt  DateTime     @default(now())

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@map("quiz_answers")
}

// ─── Certificates ─────────────────────────────────────────────────────────────

model Certificate {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId       String
  course         Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title          String
  issuedAt       DateTime @default(now())
  certificateUrl String?  // generated PDF URL on Cloudinary

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@map("certificates")
}

// ─── Bookmarks ────────────────────────────────────────────────────────────────

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lectureId String?
  lecture   Lecture? @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  courseId  String?
  course    Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, lectureId])
  @@unique([userId, courseId])
  @@index([userId])
  @@map("bookmarks")
}

// ─── Likes ────────────────────────────────────────────────────────────────────

model Like {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lectureId String
  lecture   Lecture  @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, lectureId])
  @@index([lectureId])
  @@map("likes")
}

// ─── Course Ratings ───────────────────────────────────────────────────────────

model CourseRating {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  rating    Int      // 1-5
  review    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId])
  @@index([courseId])
  @@map("course_ratings")
}

// ─── Scholar Follows ──────────────────────────────────────────────────────────

model ScholarFollow {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("UserFollowing", fields: [userId], references: [id], onDelete: Cascade)
  scholarId String
  scholar   Scholar  @relation(fields: [scholarId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, scholarId])
  @@index([scholarId])
  @@map("scholar_follows")
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read])
  @@map("notifications")
}

// ─── Media ────────────────────────────────────────────────────────────────────

model Media {
  id         String    @id @default(cuid())
  url        String
  publicId   String    // Cloudinary public ID for deletion (empty for external links)
  type       MediaType
  category   MediaCategory @default(RESOURCE)
  filename   String
  size       Int       // bytes (0 for external links)
  mimeType   String
  lectureId  String?
  lecture    Lecture?  @relation(fields: [lectureId], references: [id], onDelete: SetNull)
  courseId   String?
  course     Course?   @relation(fields: [courseId], references: [id], onDelete: SetNull)
  uploadedBy String
  createdAt  DateTime  @default(now())

  @@index([lectureId])
  @@index([courseId])
  @@map("media")
}

// ─── Discussion Forum ─────────────────────────────────────────────────────────

model ForumQuestion {
  id          String   @id @default(cuid())
  title       String
  body        String
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  courseId    String?
  resolved    Boolean  @default(false)
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  replies     ForumReply[]
  votes       ForumVote[]
  reports     Report[]

  @@index([authorId])
  @@map("forum_questions")
}

model ForumReply {
  id         String        @id @default(cuid())
  body       String
  authorId   String
  author     User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  questionId String
  question   ForumQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  isAccepted Boolean       @default(false)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  votes ForumVote[]
  reports Report[]

  @@index([questionId])
  @@map("forum_replies")
}

model ForumVote {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String?
  question   ForumQuestion? @relation(fields: [questionId], references: [id], onDelete: Cascade)
  replyId    String?
  reply      ForumReply?    @relation(fields: [replyId], references: [id], onDelete: Cascade)
  value      Int            // +1 or -1
  createdAt  DateTime       @default(now())

  @@unique([userId, questionId])
  @@unique([userId, replyId])
  @@map("forum_votes")
}

// ─── Reports ─────────────────────────────────────────────────────────────────

model Report {
  id           String       @id @default(cuid())
  reportedById String
  reportedBy   User         @relation("ReportedBy", fields: [reportedById], references: [id], onDelete: Cascade)
  reason       ReportReason
  description  String?
  status       ReportStatus @default(PENDING)
  // Target — at least one must be set
  commentId         String?
  comment           Comment?       @relation(fields: [commentId], references: [id], onDelete: Cascade)
  forumQuestionId   String?
  forumQuestion     ForumQuestion? @relation(fields: [forumQuestionId], references: [id], onDelete: Cascade)
  forumReplyId      String?
  forumReply        ForumReply?    @relation(fields: [forumReplyId], references: [id], onDelete: Cascade)
  courseId          String?
  course            Course?        @relation("CourseReports", fields: [courseId], references: [id], onDelete: Cascade)
  resolvedAt   DateTime?
  resolvedNote String?
  resolvedById String?
  resolvedBy   User?        @relation("ResolvedReports", fields: [resolvedById], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([status])
  @@index([reportedById])
  @@map("reports")
}

// ─── CMS ─────────────────────────────────────────────────────────────────────

model CmsContent {
  id        String   @id @default(cuid())
  key       String   @unique // e.g. "homepage_banner", "announcement"
  title     String?
  content   String
  imageUrl  String?
  link      String?
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cms_content")
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("faqs")
}

// ─── Audit Log ────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action     String   // e.g. "DELETE_LECTURE", "CHANGE_ROLE"
  entityType String   // e.g. "Lecture", "User"
  entityId   String?
  metadata   String?  // JSON string of extra details
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ─── Course Prerequisites ─────────────────────────────────────────────────────

model CoursePrerequisite {
  id                 String   @id @default(cuid())
  /// The course that is required before enrollment in dependentCourse
  prerequisiteCourseId String
  prerequisiteCourse   Course   @relation("PrerequisiteCourse", fields: [prerequisiteCourseId], references: [id], onDelete: Cascade)
  /// The course that requires the prerequisite to be completed first
  dependentCourseId  String
  dependentCourse    Course   @relation("DependentCourse", fields: [dependentCourseId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())

  @@unique([prerequisiteCourseId, dependentCourseId])
  @@index([dependentCourseId])
  @@map("course_prerequisites")
}

// ─── Course Announcements ────────────────────────────────────────────────────

model CourseAnnouncement {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  title     String
  body      String
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
  @@index([authorId])
  @@map("course_announcements")
}
